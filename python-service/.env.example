# Internal service token (must match PYTHON_SERVICE_TOKEN in backend)
INTERNAL_SERVICE_TOKEN=your-internal-service-token-here

# Processing configuration
DEBUG=false
MAX_FILE_SIZE_BYTES=10485760
PROCESSING_TIMEOUT_SECONDS=120

# Upload directory (must match Node backend's DOCUMENT_UPLOAD_DIR)
DOCUMENT_UPLOAD_DIR=uploads/documents

# OCR configuration (optional - auto-detected on most systems)
# TESSERACT_CMD=/usr/bin/tesseract