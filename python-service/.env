# Python Document Processing Service Configuration

# Internal authentication token (must match Node backend)
INTERNAL_SERVICE_TOKEN=vaidyam-python-service-secret-token-2026

# Debug mode (true/false)
DEBUG=true

# Maximum file size to process (in bytes)
MAX_FILE_SIZE_BYTES=10485760

# Processing timeout (in seconds)
PROCESSING_TIMEOUT_SECONDS=120

# Optional: Path to Tesseract executable if not on PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional: Path to Poppler bin directory if not on PATH
# POPPLER_PATH=C:\Program Files\poppler-24.02.0\Library\bin

# Upload directory (must match Node backend)
DOCUMENT_UPLOAD_DIR=C:/project/Vaidyam/backend/uploads/documents