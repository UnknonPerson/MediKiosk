# Copy this file to .env and provide deployment-specific values. Never commit .env.
NODE_ENV=development
PORT=7200
MONGODB_URI=mongodb://127.0.0.1:27017/vaidyam
SERVICE_NAME=vaidyam-api

# Comma-separated browser origins. This variable is required in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=false

# General public API protection. Authentication-specific limits are added with auth routes.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300

# Generate a unique secret with: openssl rand -base64 48
# Refresh tokens are opaque random values and do not need a signing secret.
JWT_ACCESS_TOKEN_SECRET=replace-with-a-unique-secret-of-at-least-32-bytes
JWT_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
JWT_ISSUER=vaidyam-api
JWT_AUDIENCE=vaidyam-client

# OTP configuration. Generate a separate hash secret with: openssl rand -base64 48
OTP_HASH_SECRET=replace-with-a-unique-secret-of-at-least-32-bytes
OTP_PROVIDER=mock
# Explicit development-only diagnostic logging; never enable this in production.
OTP_MOCK_LOG_CODES=false
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_MS=900000
OTP_SEND_RATE_LIMIT_MAX=5
OTP_VERIFY_RATE_LIMIT_MAX=10

# Development-only identity-provider defaults. Mock providers are prohibited in production.
ABHA_PROVIDER=mock
AADHAAR_PROVIDER=mock
IDENTITY_MOCK_CHALLENGE_SECRET=replace-with-a-unique-secret-of-at-least-32-bytes
IDENTITY_LINK_HASH_SECRET=replace-with-a-unique-secret-of-at-least-32-bytes
IDENTITY_MOCK_LOG_CODES=false
IDENTITY_MOCK_CHALLENGE_LENGTH=6
IDENTITY_MOCK_CHALLENGE_EXPIRY_MINUTES=5
IDENTITY_MOCK_MAX_ATTEMPTS=5
IDENTITY_RATE_LIMIT_WINDOW_MS=900000
IDENTITY_INITIATE_RATE_LIMIT_MAX=5
IDENTITY_VERIFY_RATE_LIMIT_MAX=10

# Cloudinary configuration. All three values are required together.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Upload sizes are in bytes.
MAX_PROFILE_PHOTO_SIZE=5242880
MAX_DOCUMENT_SIZE=10485760
