NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=Vaidyam <onboarding@your-verified-domain.example>

OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
VERIFICATION_OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=10

# Local development document storage. Keep this directory outside frontend source.
DOCUMENT_MAX_UPLOAD_BYTES=10485760
DOCUMENT_UPLOAD_DIR=uploads/documents

# Python document processing service
PYTHON_SERVICE_URL=http://localhost:8001
PYTHON_SERVICE_TOKEN=your-internal-service-token-here
PROCESSING_TIMEOUT_MS=120000
